+/// Audio that AVFoundation/Apple TV cannot decode (DTS, TrueHD...) is transcoded to AAC with
+/// Subler's native conversion settings; AAC/AC3/E-AC3/ALAC are copied. Text subtitles become tx3g.
+enum BackgroundTrackPolicy {
+    static func audioNeedsAAC(_ format: FourCharCode) -> Bool {
+        let formats: [FourCharCode] = [kMP42AudioCodecType_DTS, kMP42AudioCodecType_TrueHD, kMP42AudioCodecType_MLP,
+            kMP42AudioCodecType_FLAC, kMP42AudioCodecType_Vorbis, kMP42AudioCodecType_Opus,
+            kMP42AudioCodecType_MPEGLayer1, kMP42AudioCodecType_MPEGLayer2, kMP42AudioCodecType_MPEGLayer3,
+            kMP42AudioCodecType_LinearPCM]
+        return formats.contains(format)
+    }
+    static func subtitleNeedsTx3g(_ format: FourCharCode) -> Bool { format == kMP42SubtitleCodecType_Text }
+    static func isAcceptable(_ track: MP42Track) -> Bool {
+        if track is MP42AudioTrack { return isTrackMuxable(track.format) || audioNeedsAAC(track.format) }
+        return isTrackMuxable(track.format)
+    }
+    static func configure(_ track: MP42Track) {
+        if let audio = track as? MP42AudioTrack, audioNeedsAAC(audio.format) {
+            audio.conversionSettings = MP42AudioConversionSettings(format: kMP42AudioCodecType_MPEG4AAC,
+                bitRate: Prefs.audioBitrate, mixDown: MP42AudioMixdown(Prefs.audioMixdown), drc: Prefs.audioDRC)
+        } else if track is MP42SubtitleTrack, subtitleNeedsTx3g(track.format) {
+            track.conversionSettings = MP42ConversionSettings.subtitlesConversion()
+        }
+    }
+}
