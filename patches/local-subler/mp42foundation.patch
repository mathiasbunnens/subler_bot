diff --git a/MP42/MP42StrictHEVC.h b/MP42/MP42StrictHEVC.h
new file mode 100644
index 0000000..fecaeb0
--- /dev/null
+++ b/MP42/MP42StrictHEVC.h
@@ -0,0 +1,89 @@
+/* Local Subler Automation experiment. GPL-2.0-or-later.
+ * Remove only byte-equivalent in-band VPS/SPS/PPS. No encode or RPU/SEI edits.
+ * Fail closed on malformed/changing parameters, layers or parameter-only samples.
+ */
+#ifndef MP42_STRICT_HEVC_H
+#define MP42_STRICT_HEVC_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+static bool MP42HEVCConfig(const uint8_t *c, size_t n) {
+    if (!c || n < 23 || c[0] != 1) return false;
+    size_t p = 23;
+    unsigned seen = 0;
+    for (unsigned a = 0; a < c[22]; a++) {
+        if (n - p < 3) return false;
+        unsigned type = c[p++] & 63;
+        unsigned count = (c[p] << 8) | c[p+1]; p += 2;
+        if (type >= 32 && type <= 34) {
+            unsigned bit = 1u << (type - 32);
+            if (count != 1 || (seen & bit)) return false;
+            seen |= bit;
+        }
+        for (unsigned k = 0; k < count; k++) {
+            if (n - p < 2) return false;
+            size_t len = (c[p] << 8) | c[p+1]; p += 2;
+            if (len < 2 || len > n - p) return false;
+            if (((c[p] >> 1) & 63) != type || (c[p] & 0x81) ||
+                (c[p+1] & 0xf8) || !(c[p+1] & 7)) return false;
+            p += len;
+        }
+    }
+    return p == n && seen == 7;
+}
+
+static bool MP42HEVCMatches(const uint8_t *c, size_t n, const uint8_t *nal, size_t len) {
+    // Caller has validated the complete hvcC, so every read below is bounded.
+    (void)n;
+    size_t p = 23;
+    for (unsigned a = 0; a < c[22]; a++) {
+        unsigned type = c[p++] & 63;
+        unsigned count = (c[p] << 8) | c[p+1]; p += 2;
+        for (unsigned k = 0; k < count; k++) {
+            size_t size = (c[p] << 8) | c[p+1]; p += 2;
+            if (type == ((nal[0] >> 1) & 63) && size == len && !memcmp(c+p, nal, len)) return true;
+            p += size;
+        }
+    }
+    return false;
+}
+
+static bool MP42HEVCNormalize(const uint8_t *c, size_t n, uint8_t *sample, uint32_t *size) {
+    if (!size || !sample || !MP42HEVCConfig(c, n)) return false;
+    unsigned width = (c[21] & 3) + 1;
+    size_t end = *size, kept = 0;
+    // Validate the WHOLE sample before making any change.
+    for (size_t p = 0; p < end;) {
+        if (end - p < width) return false;
+        uint32_t len = 0;
+        for (unsigned b = 0; b < width; b++) len = (len << 8) | sample[p+b];
+        p += width;
+        if (len < 2 || len > end - p) return false;
+        const uint8_t *nal = sample+p;
+        if ((nal[0] & 0x81) || (nal[1] & 0xf8) || !(nal[1] & 7)) return false;
+        unsigned type = (nal[0] >> 1) & 63;
+        if (type >= 32 && type <= 34) {
+            if (!MP42HEVCMatches(c, n, nal, len)) return false;
+        } else {
+            kept += width + len;
+        }
+        p += len;
+    }
+    if (!kept) return false;
+    size_t write = 0;
+    for (size_t p = 0; p < end;) {
+        uint32_t len = 0;
+        for (unsigned b = 0; b < width; b++) len = (len << 8) | sample[p+b];
+        unsigned type = (sample[p+width] >> 1) & 63;
+        if (type < 32 || type > 34) {
+            memmove(sample+write, sample+p, width+len);
+            write += width+len;
+        }
+        p += width+len;
+    }
+    *size = (uint32_t)write;
+    return true;
+}
+#endif
