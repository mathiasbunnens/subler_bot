+    }
+    static func decide(kind: BackgroundTrackKind, format: FourCharCode) -> BackgroundTrackDecision {
+        switch kind {
+        case .audio:
+            if audioNeedsAAC(format) { return .convertToAAC }
+            return isTrackMuxable(format) ? .copy : .refuse
+        case .subtitle:
+            if subtitleNeedsTx3g(format) { return .convertToTx3g }
+            return isTrackMuxable(format) ? .copy : .skip
+        case .video, .other:
+            return isTrackMuxable(format) ? .copy : .refuse
+        }
+    }
+}
