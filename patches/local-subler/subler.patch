+@objc(SBImportBackgroundFileScriptCommand)
+class SBImportBackgroundFileScriptCommand: NSScriptCommand, ScriptCommandDocumentTargeting {
+    override func performDefaultImplementation() -> Any? {
+        guard let path = extractFilePath() else {
+            scriptErrorNumber = -1700
+            scriptErrorString = "Expected a source file."
+            return nil
+        }
+        do {
+            let url = URL(fileURLWithPath: path)
+            let importer = try MP42FileImporter(url: url)
+            guard !importer.tracks.isEmpty,
+                  importer.tracks.allSatisfy({ isTrackMuxable($0.format) && $0.conversionSettings == nil && $0.sampleDescriptions.count <= 1 }) else {
+                scriptErrorNumber = -10000
+                scriptErrorString = "Background import refuses tracks requiring conversion."
+                return nil
+            }
+            let doc = Document()
+            for track in importer.tracks {
+                if let audio = track as? MP42AudioTrack { audio.name = audio.prettyTrackName }
+                doc.mp4.addTrack(track)
+            }
+            doc.mp4.metadata.merge(importer.metadata, overwrite: true)
+            doc.fileURL = url // Search fallback; the queue writes a distinct destination.
+            NSDocumentController.shared.addDocument(doc)
+            return doc.backgroundToken
+        } catch {
+            scriptErrorNumber = -10000
+            scriptErrorString = "Background import failed."
+            return nil
+        }
+    }
+}
+
+@objc(SBHasBackgroundDocumentScriptCommand)
+class SBHasBackgroundDocumentScriptCommand: NSScriptCommand {
+    override func performDefaultImplementation() -> Any? {
+        guard let token = directParameter as? String else { return false }
+        return NSDocumentController.shared.documents.compactMap { $0 as? Document }.contains { $0.backgroundToken == token }
+    }
+}
+
