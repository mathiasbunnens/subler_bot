@@ -128,2 +128,30 @@ class SBBackgroundStateScriptCommand: NSScriptCommand {
+// This check and terminate run in the same main-thread Apple Event handler:
+// no other client can insert a document/queue item between them.
+enum BackgroundShutdownPolicy {
+    static func isSafe(documents: Int, windows: Int, active: Bool, working: Bool,
+                       items: [(String, Bool)], owned: Set<String>) -> Bool {
+        documents == 0 && windows == 0 && !active && !working &&
+            Set(items.map { $0.0 }).count == items.count &&
+            items.allSatisfy { owned.contains($0.0) && $0.1 }
+    }
+}
+
+@objc(SBQuitBackgroundScriptCommand)
+class SBQuitBackgroundScriptCommand: NSScriptCommand {
+    override func performDefaultImplementation() -> Any? {
+        guard let text = directParameter as? String else { return "refused: missing ownership" }
+        let queue = QueueController.shared
+        let items = queue.items(at: IndexSet(integersIn: 0..<Int(queue.count)))
+        guard BackgroundShutdownPolicy.isSafe(documents: NSDocumentController.shared.documents.count,
+            windows: NSApp.windows.count, active: NSApp.isActive, working: queue.status == .working,
+            items: items.map { (($0.value(forKey: "uniqueID") as? String) ?? "", $0.status == .completed) },
+            owned: Set(text.split(separator: "\n").map(String.init))) else {
+            return "refused: foreign/unknown documents or queue, or engine not idle"
+        }
+        NSApp.terminate(nil)
+        return "refused: native termination declined"
+    }
+}
+
