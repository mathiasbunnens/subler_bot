+/// Optional caller-supplied movie query (`search terms`) shared by `fetch metadata candidates`
+/// and `fetch and set metadata candidate`, so a reformulated search keeps the same result index.
+/// Absent or blank: nil, and the filename-derived terms are used unchanged.
+private func customSearchTerms(_ command: NSScriptCommand) -> MetadataSearchTerms? {
+    guard let raw = command.evaluatedArguments?["searchTerms"] as? String else { return nil }
+    let query = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+    return query.isEmpty ? nil : .movie(title: query)
+}
